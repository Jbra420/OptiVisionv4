<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OptivisionApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OptivisionApp.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarHasShadow="True">

    <!-- Página Principal Informativa Inicial (Sin TabBar) -->
    <ShellContent
        Title="Inicio OptiVision"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage"
        Shell.TabBarIsVisible="False"
        Shell.NavBarIsVisible="False" />

    <!-- Página de Login (Sin TabBar) -->
    <ShellContent
        Title="Acceso OptiVision"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"
        Shell.TabBarIsVisible="False"
        Shell.NavBarIsVisible="False" />

    <!-- Barra de Navegación del Sistema Principal -->
    <TabBar Route="MainApp">
        <Tab Title="Probador AR">
            <ShellContent
                ContentTemplate="{DataTemplate views:CatalogoPage}"
                Route="CatalogoPage" />
        </Tab>
        <Tab Title="Test Visual">
            <ShellContent
                ContentTemplate="{DataTemplate views:TestVisualPage}"
                Route="TestVisualPage" />
        </Tab>
        <Tab Title="Mis Citas">
            <ShellContent
                ContentTemplate="{DataTemplate views:CitasPage}"
                Route="CitasPage" />
        </Tab>
        <Tab Title="Mi Perfil">
            <ShellContent
                ContentTemplate="{DataTemplate views:PerfilPage}"
                Route="PerfilPage" />
        </Tab>
    </TabBar>

</Shell>
