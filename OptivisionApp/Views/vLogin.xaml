<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OptivisionApp.Views.vLogin"
             BackgroundColor="#161722"
             Title="Login">

    <Grid RowDefinitions="0.35*, 0.65*">
        
        <!-- Top Section -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
            <Label Text="OptiVision" FontSize="42" FontAttributes="Bold" TextColor="#E5A93B" HorizontalOptions="Center" />
            <Label Text="Tu salud visual, digital" FontSize="14" TextColor="#8B8D99" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Bottom Form Section -->
        <Border Grid.Row="1" BackgroundColor="#090A0F" Stroke="Transparent" Padding="30,40,30,20" VerticalOptions="FillAndExpand">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="40,40,0,0" />
            </Border.StrokeShape>
            
            <ScrollView>
                <VerticalStackLayout Spacing="20">
                    <Label Text="Iniciar sesión" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" Margin="0,0,0,10"/>
                    
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Correo electrónico o Usuario" TextColor="#8B8D99" FontSize="13" FontAttributes="Bold"/>
                        <Border BackgroundColor="#161722" Stroke="Transparent" Padding="15,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Entry x:Name="txtEmail" Text="{Binding Email}" Placeholder="Ingresa tu correo" PlaceholderColor="#606060" TextColor="#FFFFFF" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Contraseña" TextColor="#8B8D99" FontSize="13" FontAttributes="Bold"/>
                        <Border BackgroundColor="#161722" Stroke="Transparent" Padding="15,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Grid.Column="0" x:Name="txtPassword" Text="{Binding Password}" Placeholder="••••••••" IsPassword="True" PlaceholderColor="#606060" TextColor="#FFFFFF" BackgroundColor="Transparent"/>
                                <Image Grid.Column="1" Source="eye.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Remember Me & Forgot Password -->
                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,5,0,10">
                        <CheckBox Grid.Column="0" Color="#E5A93B" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Recordarme" TextColor="#8B8D99" FontSize="13" VerticalOptions="Center" Margin="5,0,0,0"/>
                        <Label Grid.Column="2" Text="¿Olvidaste tu contraseña?" TextColor="#E5A93B" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    </Grid>

                    <!-- Login Button -->
                    <Button Text="Iniciar sesión" Command="{Binding LoginCommand}" BackgroundColor="#E5A93B" TextColor="#090A0F" FontAttributes="Bold" FontSize="16" CornerRadius="15" HeightRequest="55"/>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,15,0,20">
                        <Label Text="¿No tienes una cuenta?" TextColor="#8B8D99" FontSize="14" VerticalOptions="Center"/>
                        <Label Text="Crea una" TextColor="#E5A93B" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToRegisterCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>
</ContentPage>
