<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OptivisionApp.Views.HomePage"
             BackgroundColor="#F8FAFC"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="24" RowSpacing="20">
            
            <!-- 1. Encabezado con Logotipo de la Óptica -->
            <StackLayout Grid.Row="0" HorizontalOptions="Center" Margin="0,20,0,10">
                <Image Source="optivision_logo.png" 
                       WidthRequest="100" 
                       HeightRequest="100" 
                       HorizontalOptions="Center" />
                <Label Text="OptiVision" 
                       FontSize="30" 
                       FontAttributes="Bold" 
                       TextColor="#1E3A8A" 
                       HorizontalOptions="Center" 
                       Margin="0,5,0,0"/>
                <Label Text="Plataforma de Salud Visual Inteligente" 
                       FontSize="13" 
                       TextColor="#64748B" 
                       HorizontalOptions="Center"/>
            </StackLayout>

            <!-- 2. Ilustración de Banner de la Óptica -->
            <Frame Grid.Row="1" 
                   Padding="0" 
                   CornerRadius="16" 
                   HasShadow="True" 
                   BorderColor="#E2E8F0"
                   HeightRequest="220"
                   IsClippedToBounds="True">
                <Image Source="optivision_banner.png" 
                       Aspect="AspectFill" 
                       HorizontalOptions="FillAndExpand" 
                       VerticalOptions="FillAndExpand" />
            </Frame>

            <!-- 3. Secciones Informativas de Características (Tarjetas Limpias en Azul/Blanco) -->
            <StackLayout Grid.Row="2" Spacing="16" Margin="0,10">
                
                <Label Text="Nuestros Servicios" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="#1E3A8A" 
                       Margin="0,0,0,5"/>

                <!-- Tarjeta 1: Probador AR -->
                <Frame BackgroundColor="White" BorderColor="#E2E8F0" CornerRadius="12" Padding="15" HasShadow="False">
                    <Grid ColumnDefinitions="40, *" ColumnSpacing="12">
                        <BoxView Grid.Column="0" Color="#EFF6FF" CornerRadius="8" WidthRequest="40" HeightRequest="40" VerticalOptions="Center"/>
                        <Label Grid.Column="0" Text="3D" TextColor="#2563EB" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        
                        <StackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Probador Virtual 3D" FontAttributes="Bold" TextColor="#1E293B" FontSize="14"/>
                            <Label Text="Pruébate marcos de lentes en tiempo real desde tu cámara frontal mediante Realidad Aumentada interactiva." 
                                   TextColor="#64748B" FontSize="12"/>
                        </StackLayout>
                    </Grid>
                </Frame>

                <!-- Tarjeta 2: Citas Preventivas -->
                <Frame BackgroundColor="White" BorderColor="#E2E8F0" CornerRadius="12" Padding="15" HasShadow="False">
                    <Grid ColumnDefinitions="40, *" ColumnSpacing="12">
                        <BoxView Grid.Column="0" Color="#EFF6FF" CornerRadius="8" WidthRequest="40" HeightRequest="40" VerticalOptions="Center"/>
                        <Label Grid.Column="0" Text="Cal" TextColor="#2563EB" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                        
                        <StackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Reserva de Citas Clínicas" FontAttributes="Bold" TextColor="#1E293B" FontSize="14"/>
                            <Label Text="Agenda tus consultas de agudeza visual y control de recetas en cualquiera de nuestras sucursales físicas de manera rápida." 
                                   TextColor="#64748B" FontSize="12"/>
                        </StackLayout>
                    </Grid>
                </Frame>

                <!-- Tarjeta 3: Recetas Digitales -->
                <Frame BackgroundColor="White" BorderColor="#E2E8F0" CornerRadius="12" Padding="15" HasShadow="False">
                    <Grid ColumnDefinitions="40, *" ColumnSpacing="12">
                        <BoxView Grid.Column="0" Color="#EFF6FF" CornerRadius="8" WidthRequest="40" HeightRequest="40" VerticalOptions="Center"/>
                        <Label Grid.Column="0" Text="Rx" TextColor="#2563EB" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                        
                        <StackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Historial de Fórmulas (Rx)" FontAttributes="Bold" TextColor="#1E293B" FontSize="14"/>
                            <Label Text="Consulta las dioptrías, cilindro y eje prescrito por tu optometrista en cualquier momento desde tu cuenta." 
                                   TextColor="#64748B" FontSize="12"/>
                        </StackLayout>
                    </Grid>
                </Frame>

            </StackLayout>

            <!-- 4. Stack de Botones de Acción Claras -->
            <StackLayout Grid.Row="3" Spacing="12" Margin="0,10,0,20">
                <Button Text="INICIAR SESIÓN" 
                        Clicked="OnLoginClicked"
                        BackgroundColor="#2563EB" 
                        TextColor="White" 
                        CornerRadius="8" 
                        FontAttributes="Bold" 
                        HeightRequest="50"/>

                <Button Text="CREAR UNA CUENTA" 
                        Clicked="OnRegisterClicked"
                        BackgroundColor="White" 
                        TextColor="#2563EB" 
                        BorderColor="#2563EB"
                        BorderWidth="1.5"
                        CornerRadius="8" 
                        FontAttributes="Bold" 
                        HeightRequest="50"/>
            </StackLayout>
            
        </Grid>
    </ScrollView>
</ContentPage>
