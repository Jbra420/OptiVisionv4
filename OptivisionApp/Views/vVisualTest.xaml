<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OptivisionApp.ViewModels"
             x:Class="OptivisionApp.Views.vVisualTest"
             x:DataType="vm:VisualTestViewModel"
             BackgroundColor="#090A0F"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Test Visual">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="15" Margin="0,10,0,10">
            <Grid ColumnDefinitions="Auto, *">
                <Border Grid.Column="0" BackgroundColor="#161722" Stroke="Transparent"
                        WidthRequest="40" HeightRequest="40" Margin="0,0,15,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                    <Image Source="arrow_left.svg" WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Label Grid.Column="1" Text="Test de Snellen" FontSize="24" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center"/>
            </Grid>
            
            <Label Text="{Binding ProgressText}" TextColor="#8B8D99" FontSize="14"/>
            <!-- Barra de progreso -->
            <ProgressBar Progress="{Binding ProgressPercent}" ProgressColor="#E5A93B" HeightRequest="4"/>
        </VerticalStackLayout>

        <!-- Test Card -->
        <Border Grid.Row="1" BackgroundColor="#161722" Stroke="Transparent" Padding="30" VerticalOptions="Center">
            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="25" HorizontalOptions="Center">
                <Label Text="¿Hacia dónde apunta la E?" TextColor="#8B8D99" HorizontalOptions="Center" FontSize="15"/>
                
                <!-- La E rotada dinámicamente -->
                <Label Text="E" FontSize="90" FontAttributes="Bold" TextColor="#FFFFFF" 
                       HorizontalOptions="Center" VerticalOptions="Center"
                       Rotation="{Binding CurrentRotation}"/>
                
                <Label Text="Mantén distancia de 40 cm" TextColor="#8B8D99" FontSize="12" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

        <!-- Controls (D-Pad) -->
        <VerticalStackLayout Grid.Row="2" Spacing="12" HorizontalOptions="Center" Margin="0,15,0,10">
            
            <!-- Indicador de dirección seleccionada -->
            <Label Text="{Binding SelectedDirectionDisplay}" TextColor="#E5A93B" FontAttributes="Bold"
                   HorizontalOptions="Center" FontSize="14" Margin="0,0,0,5"/>

            <!-- Botón Arriba -->
            <Border BackgroundColor="#1A1B25" Stroke="Transparent" StrokeThickness="2" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="15"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AnswerUpCommand}"/>
                </Border.GestureRecognizers>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsUpSelected}" Value="True">
                        <Setter Property="Stroke" Value="#E5A93B"/>
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <Image Source="arrow_up.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                    <Label Text="Arriba" FontSize="11" HorizontalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsUpSelected}" Value="True">
                                <Setter Property="TextColor" Value="#E5A93B"/>
                                <Setter Property="FontAttributes" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsUpSelected}" Value="False">
                                <Setter Property="TextColor" Value="#8B8D99"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Fila del medio: Izquierda, Confirmar, Derecha -->
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <!-- Botón Izquierda -->
                <Border BackgroundColor="#1A1B25" Stroke="Transparent" StrokeThickness="2" WidthRequest="70" HeightRequest="70">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AnswerLeftCommand}"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsLeftSelected}" Value="True">
                            <Setter Property="Stroke" Value="#E5A93B"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                        <Image Source="arrow_left.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                        <Label Text="Izq" FontSize="11" HorizontalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsLeftSelected}" Value="True">
                                    <Setter Property="TextColor" Value="#E5A93B"/>
                                    <Setter Property="FontAttributes" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsLeftSelected}" Value="False">
                                    <Setter Property="TextColor" Value="#8B8D99"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Border>
                
                <!-- Botón Confirmar (Centro) -->
                <Border BackgroundColor="#0D2C1C" Stroke="Transparent" WidthRequest="70" HeightRequest="70">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ConfirmAnswerCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="✓" TextColor="#2ECC71" FontSize="28" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                
                <!-- Botón Derecha -->
                <Border BackgroundColor="#1A1B25" Stroke="Transparent" StrokeThickness="2" WidthRequest="70" HeightRequest="70">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AnswerRightCommand}"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsRightSelected}" Value="True">
                            <Setter Property="Stroke" Value="#E5A93B"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                        <Image Source="arrow_right.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                        <Label Text="Der" FontSize="11" HorizontalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsRightSelected}" Value="True">
                                    <Setter Property="TextColor" Value="#E5A93B"/>
                                    <Setter Property="FontAttributes" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsRightSelected}" Value="False">
                                    <Setter Property="TextColor" Value="#8B8D99"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </HorizontalStackLayout>

            <!-- Botón Abajo -->
            <Border BackgroundColor="#1A1B25" Stroke="Transparent" StrokeThickness="2" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="15"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AnswerDownCommand}"/>
                </Border.GestureRecognizers>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsDownSelected}" Value="True">
                        <Setter Property="Stroke" Value="#E5A93B"/>
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <Image Source="arrow_down.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                    <Label Text="Abajo" FontSize="11" HorizontalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDownSelected}" Value="True">
                                <Setter Property="TextColor" Value="#E5A93B"/>
                                <Setter Property="FontAttributes" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDownSelected}" Value="False">
                                <Setter Property="TextColor" Value="#8B8D99"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Label Text="Score guardado en BD automáticamente" TextColor="#8B8D99" FontSize="11" HorizontalOptions="Center" Margin="0,10,0,0"/>

        </VerticalStackLayout>
        
    </Grid>
</ContentPage>
