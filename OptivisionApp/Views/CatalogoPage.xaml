<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OptivisionApp.Views.CatalogoPage"
             xmlns:viewmodels="clr-namespace:OptivisionApp.ViewModels"
             xmlns:models="clr-namespace:OptivisionApp.Models"
             x:DataType="viewmodels:CatalogoViewModel"
             BackgroundColor="#F8FAFC"
             Title="Catálogo de Marcos &amp; AR">

    <Grid>
        <!-- CONTENIDO PRINCIPAL: Catálogo de lentes -->
        <ScrollView IsVisible="{Binding IsArActive, Converter={StaticResource InverseBoolConverter}}">
            <StackLayout Padding="20" Spacing="20">
                
                <!-- Banner de introducción premium -->
                <Frame BackgroundColor="White" BorderColor="#CBD5E1" CornerRadius="12" Padding="20" HasShadow="False">
                    <StackLayout Spacing="5">
                        <Label Text="Probador Virtual 3D" FontSize="20" FontAttributes="Bold" TextColor="#1E3A8A"/>
                        <Label Text="Usa nuestra cámara de Realidad Aumentada para probarte marcos en tiempo real sin salir de casa." 
                               TextColor="#64748B" FontSize="13"/>
                    </StackLayout>
                </Frame>

                <!-- Filtros de Categorías -->
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="10">
                    <Button Text="Todos" Command="{Binding FiltrarCategoriaCommand}" CommandParameter="Todos" 
                            BackgroundColor="{Binding CategoriaFiltro, Converter={StaticResource CategoryActiveColorConverter}, ConverterParameter=Todos}"
                            TextColor="White" HeightRequest="40" CornerRadius="20" Padding="15,0" FontAttributes="Bold"/>
                    <Button Text="Caballeros" Command="{Binding FiltrarCategoriaCommand}" CommandParameter="Hombre"
                            BackgroundColor="{Binding CategoriaFiltro, Converter={StaticResource CategoryActiveColorConverter}, ConverterParameter=Hombre}"
                            TextColor="White" HeightRequest="40" CornerRadius="20" Padding="15,0" FontAttributes="Bold"/>
                    <Button Text="Damas" Command="{Binding FiltrarCategoriaCommand}" CommandParameter="Mujer"
                            BackgroundColor="{Binding CategoriaFiltro, Converter={StaticResource CategoryActiveColorConverter}, ConverterParameter=Mujer}"
                            TextColor="White" HeightRequest="40" CornerRadius="20" Padding="15,0" FontAttributes="Bold"/>
                    <Button Text="Unisex" Command="{Binding FiltrarCategoriaCommand}" CommandParameter="Unisex"
                            BackgroundColor="{Binding CategoriaFiltro, Converter={StaticResource CategoryActiveColorConverter}, ConverterParameter=Unisex}"
                            TextColor="White" HeightRequest="40" CornerRadius="20" Padding="15,0" FontAttributes="Bold"/>
                </StackLayout>

                <!-- Grid de Productos -->
                <CollectionView ItemsSource="{Binding Lentes}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="15" VerticalItemSpacing="15"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MarcoLente">
                            <Frame BackgroundColor="White" BorderColor="#E2E8F0" CornerRadius="15" Padding="10" HasShadow="False">
                                <StackLayout Spacing="8" VerticalOptions="FillAndExpand">
                                    
                                    <!-- Caja de Imagen Mockup del Lente con estilo elegante (Sin emojis) -->
                                    <Frame BackgroundColor="#EFF6FF" CornerRadius="8" Padding="10" HeightRequest="100" HasShadow="False" BorderColor="#DBEAFE">
                                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                                            <BoxView Color="#2563EB" HeightRequest="3" WidthRequest="60" CornerRadius="1" HorizontalOptions="Center"/>
                                            <Label Text="OptiVision" FontSize="11" FontAttributes="Bold" TextColor="#2563EB" HorizontalOptions="Center"/>
                                            <Label Text="VISTA 3D DISPONIBLE" FontSize="8" TextColor="#3B82F6" HorizontalOptions="Center"/>
                                        </StackLayout>
                                    </Frame>

                                    <!-- Nombre y detalles -->
                                    <Label Text="{Binding Nombre}" FontSize="14" FontAttributes="Bold" TextColor="#1E293B" MaxLines="1" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Marca}" FontSize="12" TextColor="#64748B"/>
                                    
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="EndAndExpand" Margin="0,5,0,0">
                                        <Label Grid.Column="0" Text="{Binding PrecioFormateado}" 
                                               FontSize="15" FontAttributes="Bold" TextColor="#0D9488" VerticalOptions="Center"/>
                                        
                                        <!-- Botón Probar AR -->
                                        <Button Grid.Column="1" Text="Probar" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CatalogoViewModel}}, Path=ProbarLenteCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#2563EB" TextColor="White" 
                                                FontSize="11" HeightRequest="32" CornerRadius="6" Padding="10,0" FontAttributes="Bold"/>
                                    </Grid>

                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </StackLayout>
        </ScrollView>

        <!-- PANTALLA COMPLETA AR SIMULATOR OVERLAY: Se activa al probar un lente -->
        <Grid IsVisible="{Binding IsArActive}" BackgroundColor="#090A0F" RowDefinitions="Auto, *, Auto">
            
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,15" BackgroundColor="#090A0F">
                <Border Grid.Column="0" BackgroundColor="#161722" Stroke="Transparent"
                        WidthRequest="40" HeightRequest="40">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DetenerPruebaCommand}"/>
                    </Border.GestureRecognizers>
                    <Image Source="arrow_left.svg" WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Label Grid.Column="1" Text="Probador AR" FontSize="18" FontAttributes="Bold"
                       TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Border Grid.Column="2" BackgroundColor="#161722" Stroke="Transparent"
                        WidthRequest="40" HeightRequest="40">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ConfirmarLenteCommand}"/>
                    </Border.GestureRecognizers>
                    <Image Source="check_circle.svg" WidthRequest="22" HeightRequest="22"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>

            <!-- Zona principal: foto + overlay -->
            <Grid Grid.Row="1" Padding="15,0">
                <VerticalStackLayout Spacing="0">
                    <Border BackgroundColor="#1E1E2E" Stroke="Transparent" HeightRequest="400">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                        <Grid>
                            <!-- Foto capturada o placeholder -->
                            <Image Source="{Binding SelfieSource}" Aspect="AspectFill"
                                   IsVisible="{Binding HasPhoto}"/>

                            <!-- Placeholder si no hay foto -->
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                                <VerticalStackLayout.Triggers>
                                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding HasPhoto}" Value="True">
                                        <Setter Property="IsVisible" Value="False"/>
                                    </DataTrigger>
                                </VerticalStackLayout.Triggers>
                                <Image Source="camera.svg" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center"/>
                                <Label Text="Toma una foto para empezar" FontSize="13" TextColor="#8B8D99" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <!-- Overlay REAL -->
                            <AbsoluteLayout IsVisible="{Binding HasPhoto}" HorizontalOptions="Fill" VerticalOptions="Fill" IsClippedToBounds="True">
                                <!-- En un entorno real se podría volver a usar {Binding LenteSeleccionado.ImagenUrl}, por ahora forzamos lentes1.png transparente del diseñador -->
                                <Image Source="lentes1.png" 
                                       AbsoluteLayout.LayoutBounds="0.5, 0.5, -1, -1"
                                       AbsoluteLayout.LayoutFlags="PositionProportional"
                                       Scale="{Binding LenteScale}"
                                       TranslationX="{Binding LenteOffsetX}"
                                       TranslationY="{Binding LenteOffsetY}"
                                       WidthRequest="250"
                                       Aspect="AspectFit" />
                            </AbsoluteLayout>

                            <!-- Badge de tinte flotando encima -->
                            <Border BackgroundColor="#00000088" Stroke="Transparent"
                                    Padding="10,4" HorizontalOptions="Start" VerticalOptions="Start"
                                    Margin="15,15,0,0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                <Label Text="{Binding SelectedTintName}" FontSize="11" FontAttributes="Bold" TextColor="#FFFFFF" TextTransform="Uppercase"/>
                            </Border>

                            <!-- Botones laterales flotantes -->
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="End" Spacing="10" Margin="0,0,12,0">
                                <Border BackgroundColor="#1A1B25" Stroke="Transparent" WidthRequest="44" HeightRequest="44">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TomarSelfieCommand}"/>
                                    </Border.GestureRecognizers>
                                    <Image Source="camera.svg" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Panel inferior: selector de colores y sliders -->
            <VerticalStackLayout Grid.Row="2" Spacing="12" Padding="20,10,20,25" BackgroundColor="#090A0F">
                <!-- Ajustes Manuales 2D -->
                <Label Text="AJUSTE MANUAL" FontSize="10" TextColor="#8B8D99" FontAttributes="Bold" CharacterSpacing="1.5" HorizontalOptions="Center"/>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="5" ColumnSpacing="10" Margin="0,0,0,10">
                    <Label Grid.Row="0" Grid.Column="0" Text="Escala" TextColor="#FFFFFF" FontSize="12" VerticalOptions="Center"/>
                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0.5" Maximum="2.0" Value="{Binding LenteScale}" MinimumTrackColor="#E5A93B"/>

                    <Label Grid.Row="1" Grid.Column="0" Text="Pos X" TextColor="#FFFFFF" FontSize="12" VerticalOptions="Center"/>
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding LenteOffsetX}" MinimumTrackColor="#E5A93B"/>

                    <Label Grid.Row="2" Grid.Column="0" Text="Pos Y" TextColor="#FFFFFF" FontSize="12" VerticalOptions="Center"/>
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="-300" Maximum="300" Value="{Binding LenteOffsetY}" MinimumTrackColor="#E5A93B"/>
                </Grid>

                <!-- Título sección: Tinte de luna -->
                <Label Text="TINTE DE LUNA" FontSize="10" TextColor="#8B8D99" FontAttributes="Bold" CharacterSpacing="1.5" HorizontalOptions="Center" Margin="0,5,0,0"/>
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Label Grid.Column="0" Text="‹" FontSize="28" TextColor="#8B8D99" VerticalOptions="Center" Margin="10,0"/>
                    <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="14">
                        <!-- Zafiro -->
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#1A5276" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSapphireSelected}" Value="True">
                                    <Setter Property="Stroke" Value="White"/>
                                    <Setter Property="StrokeThickness" Value="3"/>
                                    <Setter Property="WidthRequest" Value="56"/>
                                    <Setter Property="HeightRequest" Value="56"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTintSapphireCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <!-- Rubí -->
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#8B1A4A" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsRubySelected}" Value="True">
                                    <Setter Property="Stroke" Value="White"/>
                                    <Setter Property="StrokeThickness" Value="3"/>
                                    <Setter Property="WidthRequest" Value="56"/>
                                    <Setter Property="HeightRequest" Value="56"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTintRubyCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <!-- Esmeralda -->
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#1A6B3A" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsEmeraldSelected}" Value="True">
                                    <Setter Property="Stroke" Value="White"/>
                                    <Setter Property="StrokeThickness" Value="3"/>
                                    <Setter Property="WidthRequest" Value="56"/>
                                    <Setter Property="HeightRequest" Value="56"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTintEmeraldCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <!-- Ámbar -->
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#B7770D" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsAmberSelected}" Value="True">
                                    <Setter Property="Stroke" Value="White"/>
                                    <Setter Property="StrokeThickness" Value="3"/>
                                    <Setter Property="WidthRequest" Value="56"/>
                                    <Setter Property="HeightRequest" Value="56"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTintAmberCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#8B8D99" VerticalOptions="Center" Margin="10,0"/>
                </Grid>

                <Button Text="Tomar selfie" Command="{Binding TomarSelfieCommand}"
                        BackgroundColor="#E5A93B" TextColor="#090A0F"
                        FontAttributes="Bold" FontSize="15"
                        CornerRadius="12" HeightRequest="50">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding HasPhoto}" Value="True">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
