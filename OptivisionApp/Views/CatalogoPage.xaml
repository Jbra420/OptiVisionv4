<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OptivisionApp.Views.CatalogoPage"
             xmlns:viewmodels="clr-namespace:OptivisionApp.ViewModels"
             xmlns:models="clr-namespace:OptivisionApp.Models"
             x:DataType="viewmodels:CatalogoViewModel"
             BackgroundColor="#121212"
             Title="Catálogo de Marcos &amp; AR">

    <Grid>
        <!-- CONTENIDO PRINCIPAL: Catálogo de lentes -->
        <ScrollView IsVisible="{Binding IsArActive, Converter={StaticResource InverseBoolConverter}}">
            <StackLayout Padding="20" Spacing="20">
                
                <!-- Banner de introducción premium -->
                <Frame BackgroundColor="#1E1E2E" BorderColor="#4F3AD6" CornerRadius="12" Padding="20">
                    <StackLayout Spacing="5">
                        <Label Text="Probador Virtual 3D ✨" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Usa nuestra cámara de Realidad Aumentada para probarte marcos en tiempo real sin salir de casa." 
                               TextColor="#A5A5C7" FontSize="13"/>
                    </StackLayout>
                </Frame>

                <!-- Filtros de Categorías -->
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="10">
                    <Button Text="Todos" Command="{Binding FiltrarCategoriaCommand}" CommandParameter="Todos" 
                            BackgroundColor="{Binding CategoriaFiltro, Converter={StaticResource CategoryActiveColorConverter}, ConverterParameter=Todos}"
                            TextColor="White" HeightRequest="40" CornerRadius="20" Padding="15,0"/>
                    <Button Text="Caballeros" Command="{Binding FiltrarCategoriaCommand}" CommandParameter="Hombre"
                            BackgroundColor="{Binding CategoriaFiltro, Converter={StaticResource CategoryActiveColorConverter}, ConverterParameter=Hombre}"
                            TextColor="White" HeightRequest="40" CornerRadius="20" Padding="15,0"/>
                    <Button Text="Damas" Command="{Binding FiltrarCategoriaCommand}" CommandParameter="Mujer"
                            BackgroundColor="{Binding CategoriaFiltro, Converter={StaticResource CategoryActiveColorConverter}, ConverterParameter=Mujer}"
                            TextColor="White" HeightRequest="40" CornerRadius="20" Padding="15,0"/>
                    <Button Text="Unisex" Command="{Binding FiltrarCategoriaCommand}" CommandParameter="Unisex"
                            BackgroundColor="{Binding CategoriaFiltro, Converter={StaticResource CategoryActiveColorConverter}, ConverterParameter=Unisex}"
                            TextColor="White" HeightRequest="40" CornerRadius="20" Padding="15,0"/>
                </StackLayout>

                <!-- Grid de Productos -->
                <CollectionView ItemsSource="{Binding Lentes}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="15" VerticalItemSpacing="15"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MarcoLente">
                            <Frame BackgroundColor="#1E1E2E" BorderColor="#2F2F4A" CornerRadius="15" Padding="10" HasShadow="True">
                                <StackLayout Spacing="8" VerticalOptions="FillAndExpand">
                                    
                                    <!-- Caja de Imagen Mockup del Lente con estilo elegante -->
                                    <Frame BackgroundColor="#12121A" CornerRadius="8" Padding="10" HeightRequest="100" HasShadow="False" BorderColor="Transparent">
                                        <Label Text="🕶️" FontSize="50" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Frame>

                                    <!-- Nombre y detalles -->
                                    <Label Text="{Binding Nombre}" FontSize="14" FontAttributes="Bold" TextColor="White" MaxLines="1" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Marca}" FontSize="12" TextColor="#A5A5C7"/>
                                    
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="EndAndExpand">
                                        <Label Grid.Column="0" Text="{Binding PrecioFormateado}" 
                                               FontSize="15" FontAttributes="Bold" TextColor="#00E676" VerticalOptions="Center"/>
                                        
                                        <!-- Botón Probar AR -->
                                        <Button Grid.Column="1" Text="Probar" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CatalogoViewModel}}, Path=ProbarLenteCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#4F3AD6" TextColor="White" 
                                                FontSize="11" HeightRequest="32" CornerRadius="6" Padding="8,0"/>
                                    </Grid>

                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </StackLayout>
        </ScrollView>

        <!-- PANTALLA COMPLETA AR SIMULATOR OVERLAY: Se activa al probar un lente -->
        <Grid IsVisible="{Binding IsArActive}" BackgroundColor="Black">
            
            <!-- Simulador de flujo de cámara de dispositivo -->
            <BoxView Color="#0A0A14" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
            
            <!-- Mapeador facial interactivo y gráficos de escaneo facial en vivo -->
            <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
                
                <!-- Círculo de escaneo facial de Realidad Aumentada -->
                <Grid WidthRequest="300" HeightRequest="300" HorizontalOptions="Center">
                    <!-- Marco circular de escáner brillante -->
                    <Frame BackgroundColor="Transparent" BorderColor="#4F3AD6" CornerRadius="150" 
                           WidthRequest="300" HeightRequest="300" Padding="0" HasShadow="False">
                        
                        <Grid>
                            <!-- Simulación de malla facial y captura de cámara -->
                            <Label Text="👤" FontSize="180" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.3"/>
                            
                            <!-- Superposición virtual del marco de lente sobre la cara detectada -->
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-30,0,0">
                                <Label Text="🕶️" FontSize="100" HorizontalOptions="Center"/>
                                <Label Text="[ LENTE AR VIRTUAL ACTIVO ]" FontSize="10" FontAttributes="Bold" TextColor="#00E676" HorizontalOptions="Center"/>
                            </StackLayout>

                            <!-- Línea de escaneo animada -->
                            <BoxView Color="#00E676" HeightRequest="2" VerticalOptions="Start" Margin="0,120,0,0" Opacity="0.7"/>
                        </Grid>
                        
                    </Frame>
                </Grid>

                <Label Text="{Binding ArStatusMessage}" TextColor="White" FontSize="15" 
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                
                <Label Text="Mueve la cabeza para ver la adaptación tridimensional." TextColor="#A5A5C7" FontSize="12" 
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                
            </StackLayout>

            <!-- Controles flotantes superiores -->
            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="Start" Padding="20" BackgroundColor="#E6000000">
                <StackLayout Spacing="2">
                    <Label Text="{Binding LenteSeleccionado.Nombre}" FontAttributes="Bold" TextColor="White" FontSize="16"/>
                    <Label Text="{Binding LenteSeleccionado.Marca}" TextColor="#A5A5C7" FontSize="12"/>
                </StackLayout>
                <Label Text="{Binding LenteSeleccionado.PrecioFormateado}" TextColor="#00E676" FontAttributes="Bold" FontSize="18" 
                       HorizontalOptions="EndAndExpand" VerticalOptions="Center"/>
            </StackLayout>

            <!-- Controles flotantes inferiores -->
            <Grid VerticalOptions="End" Padding="20" ColumnDefinitions="*, *" ColumnSpacing="15" BackgroundColor="#E6000000">
                <Button Grid.Column="0" Text="Volver al Catálogo" Command="{Binding DetenerPruebaCommand}"
                        BackgroundColor="#2F2F4A" TextColor="White" CornerRadius="8" HeightRequest="50"/>
                <Button Grid.Column="1" Text="Añadir a Favoritos" BackgroundColor="#4F3AD6" TextColor="White" 
                        CornerRadius="8" HeightRequest="50"/>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
