<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OptivisionApp.ViewModels"
             x:Class="OptivisionApp.Views.vLensDetail"
             x:DataType="vm:LensDetailViewModel"
             BackgroundColor="#090A0F"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Detalle">

    <Grid>
        <!-- Contenido scrollable -->
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <!-- Zona de imagen grande (ancho completo) -->
                <Grid HeightRequest="250" BackgroundColor="#161722">
                    <Image Source="{Binding CurrentLense.ImageIcon}" Aspect="AspectFit" HeightRequest="150"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <!-- Dots indicator -->
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center"
                                           VerticalOptions="End" Margin="0,0,0,15">
                        <Border BackgroundColor="#E5A93B" WidthRequest="20" HeightRequest="4" Stroke="Transparent">
                            <Border.StrokeShape><RoundRectangle CornerRadius="2"/></Border.StrokeShape>
                        </Border>
                        <Border BackgroundColor="#8B8D99" WidthRequest="8" HeightRequest="4" Stroke="Transparent">
                            <Border.StrokeShape><RoundRectangle CornerRadius="2"/></Border.StrokeShape>
                        </Border>
                        <Border BackgroundColor="#8B8D99" WidthRequest="8" HeightRequest="4" Stroke="Transparent">
                            <Border.StrokeShape><RoundRectangle CornerRadius="2"/></Border.StrokeShape>
                        </Border>
                        <Border BackgroundColor="#8B8D99" WidthRequest="8" HeightRequest="4" Stroke="Transparent">
                            <Border.StrokeShape><RoundRectangle CornerRadius="2"/></Border.StrokeShape>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Page indicator -->
                    <Label Text="1/4" FontSize="11" TextColor="#8B8D99"
                           HorizontalOptions="End" VerticalOptions="End" Margin="0,0,20,15"/>
                </Grid>

                <!-- Información del lente -->
                <VerticalStackLayout Padding="20" Spacing="18">
                    <!-- Categoría + Precio -->
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="{Binding CurrentLense.Category, StringFormat='{0} · PREMIUM'}"
                                   FontSize="11" TextColor="#E5A93B" FontAttributes="Bold" CharacterSpacing="1"
                                   TextTransform="Uppercase"/>
                            <Label Text="{Binding CurrentLense.Name}" FontSize="24" FontAttributes="Bold" TextColor="#FFFFFF"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding CurrentLense.Price, StringFormat='${0:F0}'}"
                               FontSize="28" FontAttributes="Bold" TextColor="#E5A93B" VerticalOptions="Center"/>
                    </Grid>

                    <!-- Rating -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding CurrentLense.StarsText}" FontSize="14" TextColor="#E5A93B"/>
                        <Label Text="{Binding CurrentLense.Rating, StringFormat='{0:F1}'}" FontSize="13" TextColor="#FFFFFF"/>
                        <Label Text="{Binding CurrentLense.ReviewCount, StringFormat='· {0} reseñas'}" FontSize="13" TextColor="#8B8D99"/>
                    </HorizontalStackLayout>

                    <!-- Descripción -->
                    <Label Text="{Binding CurrentLense.Description}" FontSize="14" TextColor="#8B8D99" LineHeight="1.5"/>

                    <!-- Características -->
                    <Label Text="CARACTERÍSTICAS" FontSize="11" TextColor="#8B8D99" FontAttributes="Bold" CharacterSpacing="1.5"/>
                    <FlexLayout BindableLayout.ItemsSource="{Binding Characteristics}"
                                Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CharacteristicItem">
                                <Border BackgroundColor="#161722" Stroke="Transparent"
                                        Padding="12,8" Margin="0,0,8,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="6">
                                        <Image Source="{Binding Icon}" WidthRequest="16" HeightRequest="16"/>
                                        <Label Text="{Binding Name}" FontSize="12" TextColor="#FFFFFF" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Color del marco -->
                    <Label Text="COLOR DEL MARCO" FontSize="11" TextColor="#8B8D99" FontAttributes="Bold" CharacterSpacing="1.5"/>
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding FrameColorOptions}"
                                           Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:FrameColorItem">
                                <Border WidthRequest="42" HeightRequest="42"
                                        BackgroundColor="{Binding Color}"
                                        Stroke="{Binding StrokeColor}"
                                        StrokeThickness="{Binding StrokeThickness}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="21"/></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LensDetailViewModel}}, Path=SelectFrameColorCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <!-- Botón AR -->
                    <Border BackgroundColor="#161722" Stroke="#E5A93B" StrokeThickness="1" Padding="0"
                            HeightRequest="55" Margin="0,10,0,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToARIntroCommand}"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                            <Image Source="sparkle.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            <Label Text="Probar en Realidad Aumentada" FontSize="15"
                                   FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Botón WhatsApp -->
                    <Button Text="   Contactar por WhatsApp"
                            BackgroundColor="#25D366" TextColor="White"
                            FontAttributes="Bold" FontSize="15"
                            CornerRadius="12" HeightRequest="55"
                            Command="{Binding OpenWhatsAppCommand}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating Header overlay at the top -->
        <Grid ColumnDefinitions="Auto, *, Auto, Auto" Padding="20,15" HeightRequest="70"
              VerticalOptions="Start" BackgroundColor="Transparent">
            <Border Grid.Column="0" BackgroundColor="#80161722" Stroke="Transparent"
                    WidthRequest="40" HeightRequest="40">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
                <Image Source="arrow_left.svg" WidthRequest="20" HeightRequest="20"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Border Grid.Column="2" BackgroundColor="#80161722" Stroke="Transparent"
                    WidthRequest="40" HeightRequest="40" Margin="0,0,8,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <Image Source="share.svg" WidthRequest="18" HeightRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Border Grid.Column="3" BackgroundColor="#80161722" Stroke="Transparent"
                    WidthRequest="40" HeightRequest="40">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <Image Source="heart.svg" WidthRequest="18" HeightRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
