<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OptivisionApp.ViewModels"
             x:Class="OptivisionApp.Views.vARSimulator"
             x:DataType="vm:ARSimulatorViewModel"
             BackgroundColor="#090A0F"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Probador AR">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,15" BackgroundColor="#090A0F">
            <Border Grid.Column="0" BackgroundColor="#161722" Stroke="Transparent"
                    WidthRequest="40" HeightRequest="40">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
                <Image Source="arrow_left.svg" WidthRequest="20" HeightRequest="20"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Grid.Column="1" Text="Probador AR" FontSize="18" FontAttributes="Bold"
                   TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Border Grid.Column="2" BackgroundColor="#161722" Stroke="Transparent"
                    WidthRequest="40" HeightRequest="40">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <Image Source="filter.svg" WidthRequest="22" HeightRequest="22"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- Zona principal: foto + overlay -->
        <Grid Grid.Row="1" Padding="15,0">
            <VerticalStackLayout Spacing="0">

                <!-- Vista Completa -->
                <Border BackgroundColor="#1E1E2E" Stroke="Transparent" HeightRequest="400">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                    <Grid>
                        <!-- Foto capturada o placeholder -->
                        <Image Source="{Binding CapturedPhoto}" Aspect="AspectFill"
                               IsVisible="{Binding HasPhoto}"/>

                        <!-- Placeholder si no hay foto -->
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                             Spacing="8">
                            <VerticalStackLayout.Triggers>
                                <DataTrigger TargetType="VerticalStackLayout"
                                             Binding="{Binding HasPhoto}" Value="True">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                                <DataTrigger TargetType="VerticalStackLayout"
                                             Binding="{Binding HasPhoto}" Value="False">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </VerticalStackLayout.Triggers>
                            <Image Source="camera.svg" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center"/>
                            <Label Text="Toma una foto para empezar" FontSize="13"
                                   TextColor="#8B8D99" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Overlay REAL -->
                        <AbsoluteLayout IsVisible="{Binding HasPhoto}"
                                        HorizontalOptions="Fill" VerticalOptions="Fill"
                                        IsClippedToBounds="True">
                            
                            <!-- La imagen del lente -->
                            <Image Source="{Binding CurrentLense.ImageIcon}" 
                                   AbsoluteLayout.LayoutBounds="0.5, 0.5, -1, -1"
                                   AbsoluteLayout.LayoutFlags="PositionProportional"
                                   Scale="{Binding OverlayScale}"
                                   TranslationX="{Binding OverlayTranslateX}"
                                   TranslationY="{Binding OverlayTranslateY}"
                                   WidthRequest="250"
                                   Aspect="AspectFit" />
                        </AbsoluteLayout>

                        <!-- Badge de tinte flotando encima -->
                        <Border BackgroundColor="#00000088" Stroke="Transparent"
                                Padding="10,4" HorizontalOptions="Start" VerticalOptions="Start"
                                Margin="15,15,0,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                            <Label Text="{Binding SelectedTintName}" FontSize="11"
                                   FontAttributes="Bold" TextColor="#FFFFFF"
                                   TextTransform="Uppercase"/>
                        </Border>

                        <!-- Botones laterales flotantes -->
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="End"
                                             Spacing="10" Margin="0,0,12,0">
                            <!-- Capturar foto -->
                            <Border BackgroundColor="#1A1B25" Stroke="Transparent"
                                    WidthRequest="44" HeightRequest="44">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TakePhotoCommand}"/>
                                </Border.GestureRecognizers>
                                <Image Source="camera.svg" WidthRequest="20" HeightRequest="20"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <!-- Favorito -->
                            <Border BackgroundColor="#1A1B25" Stroke="Transparent"
                                    WidthRequest="44" HeightRequest="44">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SaveCommand}"/>
                                </Border.GestureRecognizers>
                                <Image Source="heart.svg" WidthRequest="22" HeightRequest="22"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <!-- Compartir -->
                            <Border BackgroundColor="#1A1B25" Stroke="Transparent"
                                    WidthRequest="44" HeightRequest="44">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShareCommand}"/>
                                </Border.GestureRecognizers>
                                <Image Source="share.svg" WidthRequest="20" HeightRequest="20"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <!-- Panel inferior: selector de colores -->
        <VerticalStackLayout Grid.Row="2" Spacing="12" Padding="20,10,20,25"
                             BackgroundColor="#090A0F">

            <!-- Ajustes Manuales 2D -->
            <Label Text="AJUSTE MANUAL" FontSize="10" TextColor="#8B8D99"
                   FontAttributes="Bold" CharacterSpacing="1.5" HorizontalOptions="Center"/>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="5" ColumnSpacing="10" Margin="0,0,0,10">
                <Label Grid.Row="0" Grid.Column="0" Text="Escala" TextColor="#FFFFFF" FontSize="12" VerticalOptions="Center"/>
                <Slider Grid.Row="0" Grid.Column="1" Minimum="0.5" Maximum="2.0" Value="{Binding OverlayScale}" MinimumTrackColor="#E5A93B"/>

                <Label Grid.Row="1" Grid.Column="0" Text="Pos X" TextColor="#FFFFFF" FontSize="12" VerticalOptions="Center"/>
                <Slider Grid.Row="1" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding OverlayTranslateX}" MinimumTrackColor="#E5A93B"/>

                <Label Grid.Row="2" Grid.Column="0" Text="Pos Y" TextColor="#FFFFFF" FontSize="12" VerticalOptions="Center"/>
                <Slider Grid.Row="2" Grid.Column="1" Minimum="-150" Maximum="150" Value="{Binding OverlayTranslateY}" MinimumTrackColor="#E5A93B"/>
            </Grid>

            <!-- Título sección: Tinte de luna -->
            <Label Text="TINTE DE LUNA" FontSize="10" TextColor="#8B8D99"
                   FontAttributes="Bold" CharacterSpacing="1.5" HorizontalOptions="Center"
                   Margin="0,5,0,0"/>
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Label Grid.Column="0" Text="‹" FontSize="28" TextColor="#8B8D99"
                       VerticalOptions="Center" Margin="10,0"/>
                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="14">
                    <!-- Zafiro -->
                    <Border WidthRequest="48" HeightRequest="48"
                            BackgroundColor="#1A5276" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSapphireSelected}" Value="True">
                                <Setter Property="Stroke" Value="White"/>
                                <Setter Property="StrokeThickness" Value="3"/>
                                <Setter Property="WidthRequest" Value="56"/>
                                <Setter Property="HeightRequest" Value="56"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTintSapphireCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <!-- Rubí -->
                    <Border WidthRequest="48" HeightRequest="48"
                            BackgroundColor="#8B1A4A" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsRubySelected}" Value="True">
                                <Setter Property="Stroke" Value="White"/>
                                <Setter Property="StrokeThickness" Value="3"/>
                                <Setter Property="WidthRequest" Value="56"/>
                                <Setter Property="HeightRequest" Value="56"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTintRubyCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="✓" FontSize="18" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding IsRubySelected}"/>
                    </Border>
                    <!-- Esmeralda -->
                    <Border WidthRequest="48" HeightRequest="48"
                            BackgroundColor="#1A6B3A" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsEmeraldSelected}" Value="True">
                                <Setter Property="Stroke" Value="White"/>
                                <Setter Property="StrokeThickness" Value="3"/>
                                <Setter Property="WidthRequest" Value="56"/>
                                <Setter Property="HeightRequest" Value="56"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTintEmeraldCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <!-- Ámbar -->
                    <Border WidthRequest="48" HeightRequest="48"
                            BackgroundColor="#B7770D" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsAmberSelected}" Value="True">
                                <Setter Property="Stroke" Value="White"/>
                                <Setter Property="StrokeThickness" Value="3"/>
                                <Setter Property="WidthRequest" Value="56"/>
                                <Setter Property="HeightRequest" Value="56"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTintAmberCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>
                <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#8B8D99"
                       VerticalOptions="Center" Margin="10,0"/>
            </Grid>

            <!-- Nombre del tinte -->
            <Label Text="{Binding SelectedTintName}" FontSize="13" FontAttributes="Bold"
                   TextColor="#E5A93B" HorizontalOptions="Center"
                   TextTransform="Uppercase" CharacterSpacing="2"/>

            <!-- Botón tomar foto (grande, abajo de todo) -->
            <Button Text="Tomar selfie" Command="{Binding TakePhotoCommand}"
                    BackgroundColor="#E5A93B" TextColor="#090A0F"
                    FontAttributes="Bold" FontSize="15"
                    CornerRadius="12" HeightRequest="50">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding HasPhoto}" Value="True">
                        <Setter Property="IsVisible" Value="False"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding HasPhoto}" Value="False">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
