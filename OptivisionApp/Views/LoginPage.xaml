<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OptivisionApp.Views.LoginPage"
             xmlns:viewmodels="clr-namespace:OptivisionApp.ViewModels"
             x:DataType="viewmodels:LoginViewModel"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <Grid RowDefinitions="Auto, *, Auto" Padding="30" VerticalOptions="FillAndExpand">
            
            <!-- Encabezado con Logotipo de la Óptica -->
            <StackLayout Grid.Row="0" HorizontalOptions="Center" Margin="0,30,0,10">
                <Image Source="optivision_logo.png" 
                       WidthRequest="90" 
                       HeightRequest="90" 
                       HorizontalOptions="Center"/>
                <Label Text="OptiVision" 
                       FontSize="34" 
                       FontAttributes="Bold" 
                       TextColor="#1E3A8A" 
                       HorizontalOptions="Center" 
                       Margin="0,10,0,0"/>
                <Label Text="Acceso a tu Plataforma Digital Inteligente" 
                       FontSize="13" 
                       TextColor="#64748B" 
                       HorizontalOptions="Center"/>
            </StackLayout>

            <!-- Formulario Central de Iniciar Sesión / Registro -->
            <Frame Grid.Row="1" 
                   BackgroundColor="White" 
                   BorderColor="#E2E8F0" 
                   CornerRadius="18" 
                   HasShadow="True" 
                   Margin="0,15" 
                   Padding="25">
                <StackLayout Spacing="15">
                    
                    <Label Text="{Binding Title}" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="#1E293B" 
                           Margin="0,0,0,10"
                           HorizontalOptions="Center"/>

                    <!-- Campo Nombre (Solo visible en modo registro) -->
                    <StackLayout IsVisible="{Binding IsRegisterMode}">
                        <Label Text="Nombre Completo" TextColor="#64748B" FontSize="12" Margin="0,0,0,5"/>
                        <Frame BackgroundColor="#F8FAFC" BorderColor="#E2E8F0" CornerRadius="8" Padding="12,5" HasShadow="False">
                            <Entry Text="{Binding Nombre}" Placeholder="Ej. Juan Pérez" PlaceholderColor="#94A3B8" TextColor="#1E293B"/>
                        </Frame>
                    </StackLayout>

                    <!-- Campo Correo -->
                    <StackLayout>
                        <Label Text="Correo Electrónico" TextColor="#64748B" FontSize="12" Margin="0,0,0,5"/>
                        <Frame BackgroundColor="#F8FAFC" BorderColor="#E2E8F0" CornerRadius="8" Padding="12,5" HasShadow="False">
                            <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="ejemplo@correo.com" PlaceholderColor="#94A3B8" TextColor="#1E293B"/>
                        </Frame>
                    </StackLayout>

                    <!-- Campo Contraseña -->
                    <StackLayout>
                        <Label Text="Contraseña" TextColor="#64748B" FontSize="12" Margin="0,0,0,5"/>
                        <Frame BackgroundColor="#F8FAFC" BorderColor="#E2E8F0" CornerRadius="8" Padding="12,5" HasShadow="False">
                            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="••••••••" PlaceholderColor="#94A3B8" TextColor="#1E293B"/>
                        </Frame>
                    </StackLayout>

                    <!-- Mensaje de Error -->
                    <Label Text="{Binding ErrorMessage}" TextColor="#DC2626" FontSize="13" 
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           IsVisible="{Binding HasError}" 
                           Margin="0,5,0,0"/>

                    <!-- Indicador de Carga -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#2563EB" Margin="0,10" HeightRequest="30"/>

                    <!-- Botón Enviar -->
                    <Button Text="{Binding SubmitButtonText}" 
                            Command="{Binding SubmitCommand}"
                            BackgroundColor="#2563EB" TextColor="White" 
                            CornerRadius="8" FontAttributes="Bold" HeightRequest="50" Margin="0,10,0,0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="BackgroundColor" Value="#1D4ED8"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </StackLayout>
            </Frame>

            <!-- Stack inferior para cambiar entre modos (Login / Registro) -->
            <StackLayout Grid.Row="2" VerticalOptions="End" Margin="0,10,0,10">
                <Button Text="{Binding ToggleText}" Command="{Binding ToggleModeCommand}"
                        BackgroundColor="Transparent" TextColor="#2563EB" FontSize="14" FontAttributes="Bold"/>
            </StackLayout>
            
        </Grid>
    </ScrollView>
</ContentPage>
