<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OptivisionApp.Views.LoginPage"
             xmlns:viewmodels="clr-namespace:OptivisionApp.ViewModels"
             x:DataType="viewmodels:LoginViewModel"
             BackgroundColor="#121212">

    <ScrollView>
        <Grid RowDefinitions="Auto, *, Auto" Padding="30" VerticalOptions="FillAndExpand">
            
            <!-- Encabezado con Logotipo -->
            <StackLayout Grid.Row="0" HorizontalOptions="Center" Margin="0,40,0,20">
                <Frame BackgroundColor="#1E1E2C" HasShadow="True" BorderColor="#4F3AD6" 
                       CornerRadius="45" WidthRequest="90" HeightRequest="90" Padding="0"
                       HorizontalOptions="Center">
                    <Label Text="👁️" FontSize="50" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                <Label Text="OptiVision" FontSize="36" FontAttributes="Bold" TextColor="White" 
                       HorizontalOptions="Center" Margin="0,15,0,0"/>
                <Label Text="Plataforma Óptica Digital Inteligente" FontSize="14" TextColor="#A5A5C7" 
                       HorizontalOptions="Center"/>
            </StackLayout>

            <!-- Formulario Central de Iniciar Sesión / Registro -->
            <Frame Grid.Row="1" BackgroundColor="#1E1E2E" BorderColor="#2F2F4A" CornerRadius="18" 
                   HasShadow="True" Margin="0,20" Padding="25">
                <StackLayout Spacing="15">
                    
                    <Label Text="{Binding Title}" FontSize="22" FontAttributes="Bold" TextColor="White" Margin="0,0,0,10"/>

                    <!-- Campo Nombre (Solo visible en modo registro) -->
                    <StackLayout IsVisible="{Binding IsRegisterMode}">
                        <Label Text="Nombre Completo" TextColor="#A5A5C7" FontSize="12" Margin="0,0,0,5"/>
                        <Frame BackgroundColor="#12121A" BorderColor="#2F2F4A" CornerRadius="8" Padding="12,5" HasShadow="False">
                            <Entry Text="{Binding Nombre}" Placeholder="Ej. Juan Pérez" PlaceholderColor="#5E5E7A" TextColor="White"/>
                        </Frame>
                    </StackLayout>

                    <!-- Campo Correo -->
                    <StackLayout>
                        <Label Text="Correo Electrónico" TextColor="#A5A5C7" FontSize="12" Margin="0,0,0,5"/>
                        <Frame BackgroundColor="#12121A" BorderColor="#2F2F4A" CornerRadius="8" Padding="12,5" HasShadow="False">
                            <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="ejemplo@correo.com" PlaceholderColor="#5E5E7A" TextColor="White"/>
                        </Frame>
                    </StackLayout>

                    <!-- Campo Contraseña -->
                    <StackLayout>
                        <Label Text="Contraseña" TextColor="#A5A5C7" FontSize="12" Margin="0,0,0,5"/>
                        <Frame BackgroundColor="#12121A" BorderColor="#2F2F4A" CornerRadius="8" Padding="12,5" HasShadow="False">
                            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="••••••••" PlaceholderColor="#5E5E7A" TextColor="White"/>
                        </Frame>
                    </StackLayout>

                    <!-- Mensaje de Error -->
                    <Label Text="{Binding ErrorMessage}" TextColor="#FF4A6B" FontSize="13" 
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           IsVisible="{Binding HasError}" 
                           Margin="0,5,0,0"/>

                    <!-- Indicador de Carga -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#4F3AD6" Margin="0,10" HeightRequest="30"/>

                    <!-- Botón Enviar -->
                    <Button Text="{Binding SubmitButtonText}" 
                            Command="{Binding SubmitCommand}"
                            BackgroundColor="#4F3AD6" TextColor="White" 
                            CornerRadius="8" FontAttributes="Bold" HeightRequest="50" Margin="0,10,0,0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="BackgroundColor" Value="#2A1E7A"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </StackLayout>
            </Frame>

            <!-- Stack inferior para cambiar entre modos (Login / Registro) -->
            <StackLayout Grid.Row="2" VerticalOptions="End" Margin="0,10,0,20">
                <Button Text="{Binding ToggleText}" Command="{Binding ToggleModeCommand}"
                        BackgroundColor="Transparent" TextColor="#A5A5C7" FontSize="14"/>
            </StackLayout>
            
        </Grid>
    </ScrollView>
</ContentPage>
