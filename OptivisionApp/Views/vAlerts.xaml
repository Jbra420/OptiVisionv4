<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OptivisionApp.ViewModels"
             xmlns:models="clr-namespace:Optivision.Models"
             x:Class="OptivisionApp.Views.vAlerts"
             x:DataType="vm:AlertsViewModel"
             BackgroundColor="#090A0F"
             Title="Alertas">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,15" BackgroundColor="#090A0F">
            <Border Grid.Column="0" BackgroundColor="#161722" Stroke="Transparent"
                    WidthRequest="40" HeightRequest="40">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
                <Image Source="arrow_left.svg" WidthRequest="20" HeightRequest="20"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Grid.Column="1" Text="Alertas del Día" FontSize="18" FontAttributes="Bold"
                   TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center"/>
            <BoxView Grid.Column="2" WidthRequest="40" HeightRequest="40" Color="Transparent"/>
        </Grid>

        <!-- Lista de Alertas -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="15" BindableLayout.ItemsSource="{Binding Alerts}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:AlertItem">
                        <Border BackgroundColor="#161722" Padding="15" Stroke="{Binding AccentColorHex}" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{Binding AccentColorHex}" Offset="0,5" Opacity="0.15" Radius="8" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                <Image Grid.Column="0" Source="{Binding Icon}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                    <Label Text="{Binding Description}" FontSize="13" TextColor="#8B8D99" Margin="0,3,0,0"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Padding="8,4" BackgroundColor="#090A0F" Stroke="Transparent" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding BadgeText}" FontSize="10" FontAttributes="Bold" TextColor="{Binding AccentColorHex}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
