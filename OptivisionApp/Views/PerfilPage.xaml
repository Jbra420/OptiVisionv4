<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OptivisionApp.Views.PerfilPage"
             xmlns:viewmodels="clr-namespace:OptivisionApp.ViewModels"
             x:DataType="viewmodels:PerfilViewModel"
             BackgroundColor="#F8FAFC"
             Title="Mi Perfil">

    <ContentPage.Behaviors>
        <!-- Ejecutar comando al aparecer la página para recargar datos -->
        <EventToCommandBehavior EventName="Appearing" Command="{Binding CargarDatosCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <!-- Tarjeta de Perfil -->
            <Frame BackgroundColor="White" BorderColor="#E2E8F0" CornerRadius="18" Padding="20" HasShadow="True">
                <StackLayout Spacing="10" HorizontalOptions="Center">
                    <!-- Avatar placeholder -->
                    <Frame BackgroundColor="#EFF6FF" CornerRadius="50" HeightRequest="100" WidthRequest="100" HorizontalOptions="Center" Padding="0" IsClippedToBounds="True">
                        <Label Text="👤" FontSize="50" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    
                    <Label Text="{Binding NombreCompleto}" FontSize="22" FontAttributes="Bold" TextColor="#1E293B" HorizontalOptions="Center"/>
                    <Label Text="{Binding Email}" FontSize="14" TextColor="#64748B" HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>

            <Label Text="Historial de Evaluaciones Visuales" FontSize="18" FontAttributes="Bold" TextColor="#1E3A8A" Margin="0,10,0,0"/>

            <!-- Historial Vacio -->
            <Label Text="Aún no tienes evaluaciones registradas. Ve a la pestaña 'Test Visual' para realizar uno." 
                   TextColor="#94A3B8" FontAttributes="Italic" IsVisible="{Binding TieneResultados, Converter={StaticResource InverseBoolConverter}}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,20,0,0"/>

            <!-- Lista de Historial -->
            <CollectionView ItemsSource="{Binding HistorialTest}" IsVisible="{Binding TieneResultados}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White" BorderColor="#E2E8F0" CornerRadius="12" Padding="15" Margin="0,0,0,10" HasShadow="False">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackLayout Grid.Column="0" Spacing="5">
                                    <Label Text="{Binding FechaTest, StringFormat='{0:dd MMM yyyy - HH:mm}'}" FontSize="12" TextColor="#64748B"/>
                                    <Label Text="{Binding NivelAgudeza, StringFormat='Nivel: {0}'}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A"/>
                                    <Label Text="{Binding Recomendacion}" FontSize="13" TextColor="#475569"/>
                                </StackLayout>
                                <Label Grid.Column="1" Text="{Binding Puntaje, StringFormat='{0} pts'}" FontSize="18" FontAttributes="Bold" TextColor="#2563EB" VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Botón Cerrar Sesión -->
            <Button Text="CERRAR SESIÓN" Command="{Binding CerrarSesionCommand}" 
                    BackgroundColor="#FEF2F2" TextColor="#DC2626" BorderColor="#FCA5A5" BorderWidth="1"
                    CornerRadius="8" HeightRequest="50" FontAttributes="Bold" Margin="0,20,0,0"/>

        </StackLayout>
    </ScrollView>
</ContentPage>
