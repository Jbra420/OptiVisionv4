<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OptivisionApp.ViewModels"
             xmlns:models="clr-namespace:Optivision.Models"
             x:Class="OptivisionApp.Views.vAppointments"
             x:DataType="vm:AppointmentsViewModel"
             BackgroundColor="#090A0F"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Citas">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20" BackgroundColor="#090A0F">
            <Border Grid.Column="0" BackgroundColor="#161722" Stroke="Transparent"
                    WidthRequest="40" HeightRequest="40" VerticalOptions="Center" Margin="0,0,15,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
                <Image Source="arrow_left.svg" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            
            <Label Grid.Column="1" Text="Mis Citas" FontSize="24" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center"/>
            
            <Border Grid.Column="2" BackgroundColor="#E5A93B" Stroke="Transparent"
                    WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToScheduleCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="+" FontSize="22" TextColor="#090A0F"
                       HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
            </Border>
        </Grid>

        <!-- Listado de Citas -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,20" Spacing="15">
                <CollectionView ItemsSource="{Binding Appointments}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
                            <Image Source="calendar.svg" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center"/>
                            <Label Text="No tienes citas agendadas" FontSize="15" TextColor="#8B8D99" HorizontalOptions="Center"/>
                            <Label Text="Toca el botón + para agendar una nueva cita." FontSize="12" TextColor="#8B8D99" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Appointment">
                            <Border BackgroundColor="#161722" Stroke="Transparent" Padding="15" Margin="0,0,0,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <VerticalStackLayout Spacing="5">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Image Grid.Column="0" Source="clipboard.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" Margin="0,0,12,0"/>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding ConsultationType}" FontSize="14" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                            <HorizontalStackLayout Spacing="5" Margin="0,2,0,0">
                                                <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}" FontSize="12" TextColor="#8B8D99"/>
                                                <Label Text="·" FontSize="12" TextColor="#8B8D99"/>
                                                <Label Text="{Binding Time, StringFormat='{0:hh\\:mm}'}" FontSize="12" TextColor="#8B8D99"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" BackgroundColor="#2A1F0E" Stroke="Transparent"
                                                Padding="8,4" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                            <Label Text="{Binding Status}" FontSize="10" FontAttributes="Bold" TextColor="#E5A93B">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Cancelada">
                                                        <Setter Property="TextColor" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </Grid>
                                    <HorizontalStackLayout HorizontalOptions="End" Spacing="10" Margin="0,5,0,0">
                                        <HorizontalStackLayout.Triggers>
                                            <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding Status}" Value="Cancelada">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                        </HorizontalStackLayout.Triggers>
                                        <Button Text="Reprogramar" TextColor="#E5A93B" BackgroundColor="Transparent" FontSize="12" Padding="5,0" HeightRequest="30"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentsViewModel}}, Path=RescheduleAppointmentCommand}"
                                                CommandParameter="{Binding .}"/>
                                        <Button Text="Cancelar" TextColor="#E74C3C" BackgroundColor="Transparent" FontSize="12" Padding="5,0" HeightRequest="30"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentsViewModel}}, Path=CancelAppointmentCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
